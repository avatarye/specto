{
  "schema_version": 2,
  "project": {"label": "v2-83"},
  "window_frame": {"rect": {"x": 0, "y": 0, "w": 1600, "h": 900}},
  "root_view": null,
  "views": {
    "tuto": {
      "type": "file_tree",
      "label": "Files",
      "layout": {"position": [80, 0], "size": [280, 900]}
    },
    "kobi": {
      "type": "gallery",
      "label": "cam-a run",
      "layout": {"position": [380, 0], "size": [640, 430]},
      "params": {"columns": 4}
    },
    "tamu": {
      "type": "gallery",
      "label": "picked frames",
      "layout": {"position": [380, 450], "size": [640, 430]},
      "params": {"columns": 4}
    },
    "new1": {
      "type": "json",
      "label": "loose inspector",
      "layout": {"position": [1040, 0], "size": [480, 430]}
    }
  },
  "links": {
    "l1": {
      "kind": "intaker",
      "label": "project files",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "tuto", "port": "data"},
      "params": {"sources": ["."], "watch": true},
      "summary": {"sentence": "The file tree shows every file in the project folder."}
    },
    "l2": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "cam-a frames",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "kobi", "port": "data"},
      "params": {
        "sources": ["runs/run-001/cam-a"],
        "screener": ["@images"],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "group_by": ["frame"]
      },
      "summary": {"sentence": "The cam-a gallery always shows the cam-a run."}
    },
    "l3": {
      "kind": "intaker",
      "scope": "selection",
      "label": "picked frames",
      "source": {"view": "tuto", "port": "selected_files"},
      "target": {"view": "tamu", "port": "data"},
      "params": {"screener": ["@images"], "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$", "group_by": ["frame"]},
      "summary": {"sentence": "The lower gallery shows the frames you pick."}
    }
  }
}
