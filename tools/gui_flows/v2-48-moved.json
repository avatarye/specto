{
  "schema_version": 2,
  "project": {"label": "v2-48-proj"},
  "window_frame": {"rect": {"x": 0, "y": 0, "w": 1600, "h": 900}},
  "root_view": null,
  "views": {
    "fege": {
      "type": "file_tree",
      "label": "Files",
      "layout": {"position": [80, 0], "size": [280, 900]},
      "params": {},
      "locked": false
    },
    "kobi": {
      "type": "gallery",
      "label": "Drops (watched, locked)",
      "layout": {"position": [500, 60], "size": [900, 600]},
      "params": {"columns": 4},
      "locked": false
    }
  },
  "links": {
    "l1": {
      "kind": "intaker",
      "label": "project files",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "fege", "port": "data"},
      "two_way": false,
      "params": {"sources": ["."], "watch": true},
      "summary": {"sentence": "The file tree shows every file in the project folder."}
    },
    "l2": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "dropped frames",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "kobi", "port": "data"},
      "two_way": false,
      "params": {
        "sources": ["drops"],
        "screener": ["@images"],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "group_by": ["frame"],
        "watch": true
      },
      "summary": {"sentence": "The gallery shows every frame dropped into the drops folder, live."}
    }
  }
}
