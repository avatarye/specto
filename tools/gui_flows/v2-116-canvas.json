{
  "schema_version": 2,
  "project": {"label": "v2-116-proj"},
  "window_frame": {"rect": {"x": 0, "y": 0, "w": 1600, "h": 900}},
  "root_view": null,
  "views": {
    "fege": {
      "type": "file_tree",
      "label": "Files",
      "layout": {"position": [80, 0], "size": [320, 820]},
      "params": {},
      "locked": false
    },
    "dena": {
      "type": "image",
      "label": "Picked frame",
      "layout": {"position": [420, 0], "size": [900, 600]},
      "params": {},
      "locked": false
    }
  },
  "links": {
    "l1": {
      "kind": "intaker",
      "label": "project files",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "fege", "port": "data"},
      "two_way": false,
      "params": {"sources": ["."], "watch": true},
      "summary": {"sentence": "The file tree shows every file in the project folder."}
    },
    "l2": {
      "kind": "intaker",
      "scope": "selection",
      "label": "picked frames",
      "source": {"view": "fege", "port": "selected_files"},
      "target": {"view": "dena", "port": "data"},
      "two_way": false,
      "params": {
        "sources": ["runs/run-001/cam-a"],
        "screener": ["@images"],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "group_by": ["frame"],
        "sort": "natural"
      },
      "summary": {"sentence": "The image view shows the cam-a frames picked in the file tree."}
    }
  }
}
