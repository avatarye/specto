{
  "schema_version": 2,
  "project": {
    "label": "v2-130-proj"
  },
  "window_frame": {
    "rect": {
      "x": 0,
      "y": 0,
      "w": 1600,
      "h": 900
    }
  },
  "root_view": null,
  "views": {
    "fege": {
      "type": "file_tree",
      "label": "Files",
      "layout": {
        "position": [
          0,
          0
        ],
        "size": [
          250,
          860
        ]
      },
      "params": {},
      "locked": false
    },
    "kobi": {
      "type": "gallery",
      "label": "Front frames",
      "layout": {
        "position": [
          260,
          0
        ],
        "size": [
          420,
          300
        ]
      },
      "params": {
        "tile": 120
      },
      "locked": false
    },
    "tamu": {
      "type": "json",
      "label": "Frame sidecar",
      "layout": {
        "position": [
          690,
          0
        ],
        "size": [
          420,
          300
        ]
      },
      "params": {},
      "locked": false
    },
    "rena": {
      "type": "markdown",
      "label": "Notes",
      "layout": {
        "position": [
          260,
          320
        ],
        "size": [
          560,
          420
        ]
      },
      "params": {},
      "locked": false
    },
    "pola": {
      "type": "map",
      "label": "Sample sites",
      "layout": {
        "position": [
          830,
          320
        ],
        "size": [
          750,
          420
        ]
      },
      "params": {},
      "locked": false
    },
    "mobe": {
      "type": "html",
      "label": "Report",
      "layout": {
        "position": [
          1120,
          0
        ],
        "size": [
          460,
          300
        ]
      },
      "params": {},
      "locked": false
    }
  },
  "links": {
    "l1": {
      "kind": "intaker",
      "label": "project files",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "fege",
        "port": "data"
      },
      "two_way": false,
      "params": {
        "sources": [
          "."
        ],
        "watch": false
      },
      "summary": {
        "sentence": "The file tree shows every file in the project folder."
      }
    },
    "l2": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "cam-a frames",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "kobi",
        "port": "data"
      },
      "two_way": false,
      "params": {
        "sources": [
          "runs/run-001/cam-a"
        ],
        "screener": [
          "@images"
        ],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "sort": "natural"
      },
      "summary": {
        "sentence": "The gallery shows the cam-a frames of the project."
      }
    },
    "l3": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "frame sidecars",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "tamu",
        "port": "data"
      },
      "two_way": false,
      "params": {
        "sources": [
          "runs/run-001/cam-a"
        ],
        "screener": [
          "@json"
        ],
        "keys": "(?P<frame>\\d{5})_\\d+\\.json$",
        "sort": "natural"
      },
      "summary": {
        "sentence": "The JSON view holds the sidecar of every cam-a frame."
      }
    },
    "l4": {
      "kind": "follow",
      "label": "sidecar of the picked frame",
      "source": {
        "view": "kobi",
        "port": "selection"
      },
      "target": {
        "view": "tamu",
        "port": "selection"
      },
      "two_way": false,
      "params": {
        "match": null
      },
      "summary": {
        "sentence": "Picking a frame in the gallery shows its JSON sidecar."
      }
    },
    "l5": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "notes",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "rena",
        "port": "data"
      },
      "two_way": false,
      "params": {
        "sources": [
          "notes"
        ],
        "screener": [
          "@markdown"
        ],
        "sort": "natural"
      },
      "summary": {
        "sentence": "The notes view shows the markdown notes of the project."
      }
    },
    "l6": {
      "kind": "read_contents",
      "label": "geo files",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "pola",
        "port": "features"
      },
      "two_way": false,
      "params": {
        "sources": [
          "geo"
        ],
        "format": null
      },
      "summary": {
        "sentence": "The map draws every GeoJSON file under geo/ as a layer."
      }
    },
    "l7": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "report pages",
      "source": {
        "view": "project",
        "port": "all_files"
      },
      "target": {
        "view": "mobe",
        "port": "data"
      },
      "two_way": false,
      "params": {
        "sources": [
          "report"
        ],
        "screener": [
          "@html"
        ],
        "sort": "natural"
      },
      "summary": {
        "sentence": "The html view shows the pages of the report."
      }
    }
  }
}