{
  "schema_version": 2,
  "project": {"label": "v2-96-proj"},
  "window_frame": {"rect": {"x": 0, "y": 0, "w": 1576, "h": 804}},
  "root_view": null,
  "views": {
    "fege": {
      "type": "file_tree",
      "label": "Files",
      "layout": {"position": [80, 0], "size": [280, 804]},
      "params": {},
      "locked": false
    },
    "kobi": {
      "type": "gallery",
      "label": "Front frames",
      "layout": {"position": [720, 420], "size": [340, 300]},
      "params": {"tile": 120},
      "locked": false
    },
    "tamu": {
      "type": "gallery",
      "label": "Rear frames",
      "layout": {"position": [1300, 40], "size": [340, 300]},
      "params": {"tile": 120},
      "locked": false
    }
  },
  "links": {
    "l1": {
      "kind": "intaker",
      "label": "project files",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "fege", "port": "data"},
      "two_way": false,
      "params": {"sources": ["."], "watch": true},
      "summary": {"sentence": "The file tree shows every file in the project folder."}
    },
    "l2": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "cam-a frames",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "kobi", "port": "data"},
      "two_way": false,
      "params": {
        "sources": ["runs/run-001/cam-a"],
        "screener": ["@images"],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "group_by": ["frame"],
        "sort": "natural"
      },
      "summary": {"sentence": "The gallery shows every front camera frame under the file tree."}
    },
    "l3": {
      "kind": "intaker",
      "scope": "pinned",
      "label": "cam-b from project",
      "source": {"view": "project", "port": "all_files"},
      "target": {"view": "tamu", "port": "data"},
      "two_way": false,
      "params": {
        "sources": ["runs/run-001/cam-b"],
        "screener": ["@images"],
        "keys": "(?P<frame>\\d{5})_\\d+\\.jpg$",
        "group_by": ["frame"],
        "sort": "natural"
      },
      "summary": {"sentence": "Rear frames straight from the project folder."}
    },
    "l4": {
      "kind": "follow",
      "label": "linked on frame",
      "source": {"view": "kobi", "port": "selection"},
      "target": {"view": "tamu", "port": "selection"},
      "two_way": true,
      "params": {"match": "frame"},
      "summary": {"sentence": "Selecting a frame in the cam-a gallery selects the same frame in the cam-b one, and back."}
    }
  }
}
